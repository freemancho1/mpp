# .env 작성용 예시. 이 파일을 .env 로 복사한 뒤 값을 채운다.
# .env 는 Git에 올리지 않는다. 실제 키 값을 이 예시 파일에 쓰지 않는다.

# KIS Open API (개발 중에는 모의투자 키만 쓴다)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=

# 데이터 루트 (비우면 config/paths.yaml 기본값 ~/datas/mpp 사용)
MPP_DATA_ROOT=

# 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
